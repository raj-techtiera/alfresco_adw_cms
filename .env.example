# Development proxy targets (used by apps/content-ee/proxy.conf.js when running `nx serve content-ee`)
# Copy .env.example to .env and set your Alfresco/APS backend URLs.
#
# NG_APP_* vars are injected into the Angular app by @ngx-env/builder (see environments/*.ts).
# Unprefixed BASE_URL / APS_URL are Node-only (dev proxy) and are NOT bundled into the client.

# Alfresco Content Services + Identity (Share, /alfresco, /auth) — proxy only
BASE_URL=http://192.168.60.142

# Parent folder node for project listing and Vendor Document Registry uploads (`/nodes/{id}/children`)
NG_APP_NODE_ID=3c8b95ef-07e3-4cfd-8b95-ef07e34cfd54

# Business Units page — parent folder for project cards (`/nodes/{id}/children?include=properties`)
NG_APP_BUSINESS_UNITS_NODE_ID=3d769e0c-edc3-4d33-b69e-0cedc3dd3344

# Create Business Unit Activiti process
NG_APP_CREATE_BUSINESS_UNIT_PROCESS_DEFINITION_KEY=EDMS-Create-Business-Unit
NG_APP_CREATE_BUSINESS_UNIT_PROCESS_NAME=Create Business Unit
NG_APP_CREATE_BUSINESS_UNIT_BUSINESS_KEY=EDMS-Create-Business-Unit

# Image upload parent folder (create project flow only)
NG_APP_IMAGE_NODE_ID=fcfaae7e-4083-4142-baae-7e4083914293

# Asset hierarchy root folder
NG_APP_ASSETS_NODE_ID=5bfe02a5-6cb5-40af-be02-a56cb500af09

# Folder template node for create-asset workspace
NG_APP_ASSETS_TEMPLATE_ID=44be7673-ca5e-421e-be76-73ca5e121e9b

# Parent folder whose children populate the vendor dropdown (Create Project / Create PO)
NG_APP_VENDOR_LIST_PARENT_NODE_ID=0dfd18cb-a09a-4b21-bd18-cba09acb21c5

# Program Portfolio parent folder (`TYPE:'shaedms:programIdentification'` search)
NG_APP_PROGRAMS_PARENT_NODE_ID=502cf3eb-f8ea-49cc-acf3-ebf8ea59cc0d

# Document Management nav — folder opened in the project explorer
NG_APP_DOCUMENT_MANAGEMENT_NODE_ID=7e12eeb4-f115-4852-92ee-b4f115185249

# Alfresco site id for group-permission dropdown (`/sites/{id}/group-members`)
NG_APP_EDMS_CENTRAL_SITE_ID=safran-hal

# Watermark templates (`/nodes/-root-/children`)
NG_APP_WATERMARK_TEMPLATE_NODE_TYPE=edms:watermarkTemplate
NG_APP_WATERMARK_TEXT_RELATIVE_PATH=Sites/safran-hal/documentLibrary/Watermark Templates/Text
NG_APP_WATERMARK_IMAGE_RELATIVE_PATH=Sites/safran-hal/documentLibrary/Watermark Templates/Images

# Vendor list parent folder (Create Project / Create PO vendor dropdown)
NG_APP_VENDOR_LIST_PARENT_NODE_ID=be21b2dd-ec86-4df5-a1b2-ddec86fdf526

# Activiti process-instances API (relative path; forwarded by the dev proxy)
NG_APP_PROCESS_INSTANCES_URL=/activiti-app/api/enterprise/process-instances

# Activiti process definition keys
NG_APP_CREATE_ASSET_PROCESS_DEFINITION_KEY=create-asset-hierarchy
NG_APP_CREATE_PROJECT_PROCESS_DEFINITION_KEY=EDMS-create-project-template-v2
NG_APP_CREATE_PROGRAM_PROCESS_DEFINITION_KEY=SHAE-create-program-template-v1
NG_APP_CREATE_PROGRAM_BUSINESS_KEY=SHAE-create-program-template-v1
NG_APP_CREATE_PO_PROCESS_DEFINITION_KEY=EDMS-Create-PO-Template-v2
NG_APP_HANDOVER_GAP_REPORT_PROCESS_DEFINITION_KEY=EDMS-Download-Handover-Gap-Report
NG_APP_FINAL_HANDOVER_PROCESS_DEFINITION_KEY=EDMS-Final-Handover-Package
NG_APP_BULK_PROCESS_DEFINITION_KEY=EDMS-Bulk-Project-Document
NG_APP_BULK_PROXY_REGISTRATION_PROCESS_DEFINITION_KEY=DMS-Bulk-Proxy-Registration-v1
NG_APP_DOCUMENT_NUMBER_CHANGE_PROCESS_DEFINITION_KEY=DocumentNumberChange
NG_APP_RED_LINE_MARKUP_PROCESS_DEFINITION_KEY=RedLineMark-UpApproval
NG_APP_RED_LINE_MARKUP_PROCESS_NAME=Red Line Mark Up Approval
NG_APP_RED_LINE_MARKUP_BUSINESS_KEY=RedLineMark-UpApproval
NG_APP_JR_REQUEST_PROCESS_DEFINITION_KEY=SHAE-Internal-JR-Process
NG_APP_JR_REQUEST_BUSINESS_KEY=SHAE-Internal-JR-Process

# Optional CARTO basemap API key for Leaflet Voyager tiles (https://carto.com/basemaps/apikey).
# Leave empty to use OpenStreetMap tiles (no key required).
# NG_APP_CARTO_API_KEY=

# Header logo — Node-only, substituted into application.logo in app.config.json by prepare-app-config
LOGO_URL=assets/images/DMS.png

# Login / in-app logos — must use NG_APP_ prefix to be bundled by @ngx-env/builder
NG_APP_LOGO_URL=assets/images/DMS.png
NG_APP_LOGO_IMAGE_URL=assets/images/DMS.png

# Alfresco Process Services (Activiti) - optional, defaults to BASE_URL if not set
# APS_URL=http://192.168.60.142

# For production build, set BUILD_ENV=production when building:
#   BUILD_ENV=production nx build content-ee --configuration=production
