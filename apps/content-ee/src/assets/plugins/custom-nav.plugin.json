{
  "$schema": "../../../extension.schema.json",
  "$id": "app.custom.nav",
  "$name": "Custom Navigation",
  "$version": "1.0.0",
  "actions": [
    {
      "id": "app.action.open.classification",
      "type": "NAVIGATE_URL",
      "payload": "$('/classification/' + context.selection.first.entry.id)"
    }
  ],
  "features": {
    "search": [
      {
        "id": "app.search.engineering-documents",
        "order": 350,
        "name": "CUSTOM_NAV.SEARCH.ENGINEERING_DOCUMENTS",
        "default": false,
        "filterWithContains": true,
        "app:fields": [
          "cm:name",
          "cm:title",
          "cm:description",
          "eng:documenttitle",
          "eng:documentno",
          "eng:documenttype",
          "eng:projectno",
          "TEXT",
          "TAG"
        ],
        "include": ["path", "allowableOperations", "properties"],
        "sorting": {
          "options": [
            {
              "key": "score",
              "label": "SEARCH.SORT.RELEVANCE",
              "type": "SCORE",
              "field": "score",
              "ascending": false
            },
            {
              "key": "name",
              "label": "SEARCH.SORT.FILENAME",
              "type": "FIELD",
              "field": "cm:name",
              "ascending": true
            },
            {
              "key": "title",
              "label": "SEARCH.SORT.TITLE",
              "type": "FIELD",
              "field": "cm:title",
              "ascending": true
            },
            {
              "key": "created",
              "label": "SEARCH.SORT.CREATE_DATE",
              "type": "FIELD",
              "field": "cm:created",
              "ascending": true
            }
          ],
          "defaults": [
            {
              "key": "score",
              "type": "SCORE",
              "field": "score",
              "ascending": false
            }
          ]
        },
        "aca:triggeredOnChange": false,
        "resetButton": true,
        "filterQueries": [
          { "query": "+TYPE:'cm:folder' OR +TYPE:'cm:content'" },
          {
            "query": "-TYPE:'cm:thumbnail' AND -TYPE:'cm:failedThumbnail' AND -TYPE:'cm:rating'"
          },
          { "query": "-cm:creator:System" },
          {
            "query": "-TYPE:'st:site' AND -ASPECT:'st:siteContainer' AND -ASPECT:'sys:hidden'"
          },
          {
            "query": "-TYPE:'dl:dataList' AND -TYPE:'dl:todoList' AND -TYPE:'dl:issue'"
          },
          { "query": "-TYPE:'fm:topic' AND -TYPE:'fm:post'" },
          { "query": "-TYPE:'lnk:link'" },
          { "query": "-PATH:'//cm:wiki/*'" }
        ],
        "categories": [
          {
            "id": "logic",
            "name": "SEARCH.CATEGORIES.LOGIC",
            "enabled": true,
            "component": {
              "selector": "logical-filter",
              "settings": {
                "allowUpdateOnChange": false,
                "hideDefaultAction": true,
                "field": "cm:name,cm:title,cm:description,eng:documenttitle,eng:documentno,eng:documenttype,eng:projectno,TEXT,TAG"
              }
            }
          },
          {
            "id": "createdModifiedDateRange",
            "name": "SEARCH.CATEGORIES.DATE",
            "enabled": true,
            "component": {
              "selector": "date-range",
              "settings": {
                "field": "cm:created,cm:modified",
                "dateFormat": "dd-MMM-yy",
                "maxDate": "today",
                "displayedLabelsByField": {
                  "cm:created": "SEARCH.CATEGORIES.DATE_TABS.CREATED",
                  "cm:modified": "SEARCH.CATEGORIES.DATE_TABS.MODIFIED"
                }
              }
            }
          },
          {
            "id": "engDocumentTitle",
            "name": "Document Title",
            "enabled": true,
            "expanded": true,
            "component": {
              "selector": "text",
              "settings": {
                "allowUpdateOnChange": false,
                "hideDefaultAction": true,
                "field": "eng:documenttitle",
                "placeholder": "Enter document title"
              }
            }
          },
          {
            "id": "engDocumentNo",
            "name": "Document No",
            "enabled": true,
            "expanded": true,
            "component": {
              "selector": "text",
              "settings": {
                "allowUpdateOnChange": false,
                "hideDefaultAction": true,
                "field": "eng:documentno",
                "placeholder": "Enter document number"
              }
            }
          },
          {
            "id": "engDocumentType",
            "name": "Document Type",
            "enabled": true,
            "expanded": true,
            "component": {
              "selector": "text",
              "settings": {
                "allowUpdateOnChange": false,
                "hideDefaultAction": true,
                "field": "eng:documenttype",
                "placeholder": "Enter document type"
              }
            }
          },
          {
            "id": "engProjectNo",
            "name": "Project No",
            "enabled": true,
            "expanded": true,
            "component": {
              "selector": "text",
              "settings": {
                "allowUpdateOnChange": false,
                "hideDefaultAction": true,
                "field": "eng:projectno",
                "placeholder": "Enter project number"
              }
            }
          }
        ]
      }
    ],
