{
    "name": "content-ee-dashboard-extension",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/content-ee/dashboard-extension/src",
    "prefix": "acs",
    "targets": {
        "build": {
            "executor": "@nx/angular:package",
            "outputs": ["{workspaceRoot}/dist/libs/content-ee/dashboard-extension"],
            "options": {
                "project": "libs/content-ee/dashboard-extension/ng-package.json"
            },
            "configurations": {
                "production": {
                    "tsConfig": "libs/content-ee/dashboard-extension/tsconfig.lib.prod.json"
                },
                "development": {
                    "tsConfig": "libs/content-ee/dashboard-extension/tsconfig.lib.json"
                },
                "adf": {
                    "tsConfig": "libs/content-ee/dashboard-extension/tsconfig.lib.adf.json"
                }
            },
            "defaultConfiguration": "production"
        },
        "test": {
            "executor": "@angular-devkit/build-angular:karma",
            "options": {
                "codeCoverage": true,
                "main": "libs/content-ee/dashboard-extension/src/test.ts",
                "tsConfig": "libs/content-ee/dashboard-extension/tsconfig.spec.json",
                "karmaConfig": "libs/content-ee/dashboard-extension/karma.conf.js",
                "stylePreprocessorOptions": {
                    "includePaths": ["./node_modules"]
                }
            },
            "configurations": {
                "adf": {
                    "tsConfig": "libs/content-ee/dashboard-extension/tsconfig.spec.adf.json",
                    "karmaConfig": "libs/content-ee/dashboard-extension/karma.conf.js",
                    "progress": false,
                    "codeCoverage": false,
                    "stylePreprocessorOptions": {
                        "includePaths": ["../alfresco-ng2-components/lib/core/src/lib"]
                    }
                },
                "aca": {
                    "tsConfig": "libs/content-ee/dashboard-extension/tsconfig.spec.aca.json",
                    "karmaConfig": "libs/content-ee/dashboard-extension/karma.conf.js",
                    "progress": false,
                    "codeCoverage": false
                },
                "adfaca": {
                    "tsConfig": "libs/content-ee/dashboard-extension/tsconfig.spec.adf.aca.json",
                    "karmaConfig": "libs/content-ee/dashboard-extension/karma.conf.js",
                    "progress": false,
                    "codeCoverage": false,
                    "stylePreprocessorOptions": {
                        "includePaths": ["../alfresco-ng2-components/lib/core/src/lib"]
                    }
                }
            },
            "outputs": ["{workspaceRoot}/coverage/libs/content-ee/dashboard-extension"]        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"],
            "options": {
                "lintFilePatterns": [
                    "libs/content-ee/dashboard-extension/**/*.ts",
                    "libs/content-ee/dashboard-extension/**/*.html"
                ]
            }
        },
        "stylelint": {
            "executor": "nx-stylelint:lint",
            "options": {
                "lintFilePatterns": ["libs/content-ee/dashboard-extension/**/*.scss"]
            }
        },
        "npm-publish": {
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "options": {
                "cwd": "dist/libs/content-ee/dashboard-extension",
                "commands": [
                    {
                        "command": "npm version --allow-same-version --no-git-tag-version --force {args.new-version}",
                        "forwardAllArgs": true
                    },
                    {
                        "command": "echo @alfresco:registry=https://npm.pkg.github.com > .npmrc",
                        "forwardAllArgs": false
                    },
                    {
                        "command": "echo '//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}' >> .npmrc",
                        "forwardAllArgs": false
                    },
                    {
                        "command": "npm publish --access restricted --tag {args.tag}",
                        "forwardAllArgs": true
                    }
                ],
                "parallel": false
            }
        }
    },
    "tags": ["scope:content-ee-dashboard-extension", "type:feature", "scope:content-ee"]
}
